# AURA — ejemplo de variables de entorno (sin valores reales).
# Copiar a .env / src/.env.local / api/.env según corresponda. Nunca commitear valores.
# Ver .gitignore: .env y .env.local están ignorados.

# --- API (api/) ---
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/aura
# Token bearer obligatorio para todas las rutas /api/* (Authorization: Bearer <token>).
# Si falta, /api/* responde 503 (fail closed). /health sigue siendo público.
# Generar con: openssl rand -hex 32
AURA_API_TOKEN=

# --- Benchmarks / validación local (opcional) ---
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=600000

# --- Opt-in E2E con proveedores reales (solo local, nunca CI) ---
# AURA_PROVIDER_VALIDATION=chrome|ollama|gemini|all
AURA_PROVIDER_VALIDATION=
AURA_OLLAMA_URL=http://127.0.0.1:11434

# --- Frontend (src/, prefijo VITE_) ---
# La configuración de IA es local (localStorage); el navegador no la sincroniza con la API.
VITE_API_URL=http://localhost:4000
VITE_AURA_BUILD_SHA=
VITE_CONTRACTS_V2_ENABLED=false
VITE_ENABLE_WEBLLM_EXPERIMENTAL=false
