{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/casabero-labs/aura/main/docs/product/aura/phase_10/L9_E2E_EVIDENCE_TEMPLATE.json",
  "title": "Phase 10 L9 — E2E Export Contract Evidence Template",
  "description": "Template for the E2E Playwright evidence generated by aura-export-contract.spec.ts. Documents the technical export contract validation for aura-technical-export v2.0.",
  "type": "object",
  "required": ["testRun", "validations", "exportContract", "calibrationEvidence"],
  "properties": {
    "testRun": {
      "type": "object",
      "description": "Metadata about the test run",
      "required": ["timestamp", "phase", "dataset", "harness"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the test was executed"
        },
        "phase": {
          "type": "string",
          "const": "L9",
          "description": "Phase identifier"
        },
        "dataset": {
          "type": "string",
          "description": "Synthetic dataset filename used"
        },
        "harness": {
          "type": "string",
          "description": "E2E harness used (e.g., Phase4 E2E Harness)"
        }
      }
    },
    "validations": {
      "type": "object",
      "description": "Individual validation results",
      "properties": {
        "exportContract_name_correct": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "expected": { "type": "string" },
            "actual": { "type": "string" }
          }
        },
        "exportContract_version_correct": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "expected": { "type": "string" },
            "actual": { "type": "string" }
          }
        },
        "calibrationEvidence_exists": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "actual": { "type": "string" }
          }
        },
        "experiment_block_absent": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "actual": { "type": "string" }
          }
        },
        "calibrationEvidence_canonical": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "actual": { "type": "array" }
          }
        },
        "deprecated_migration_declared": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "actual": { "type": "array" }
          }
        },
        "legacyAlias_notIncluded": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "actual": { "type": "boolean" }
          }
        }
      }
    },
    "exportContract": {
      "type": "object",
      "description": "The exportContract block from the downloaded JSON",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "canonicalBlocks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deprecatedBlocks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "legacyAliasIncluded": { "type": "boolean" },
            "migration": { "type": "string" }
          }
        }
      }
    },
    "calibrationEvidence": {
      "type": "object",
      "description": "The calibrationEvidence block from the downloaded JSON",
      "properties": {
        "classification": {
          "type": "string",
          "const": "experimental"
        },
        "summaryStatus": {
          "type": "string",
          "enum": ["none", "attempted", "preliminary", "formal"]
        },
        "resultsCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "allPassed": {
      "type": "boolean",
      "description": "True if all validations passed"
    }
  }
}
