{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/casabero-labs/aura/main/docs/product/aura/contracts/aura-technical-export.schema.json",
  "title": "AURA Technical Export 2.1",
  "description": "Contrato estructural independiente para el paquete técnico exportado por AURA. La versión 2.1 añade evidencia opcional de remediación verificable y conserva lectura histórica 2.0 en el validador de aplicación.",
  "$comment": "El builder canónico produce 2.1. El validador de aplicación acepta 2.0 histórico sin remediationExecution; no existe un segundo builder legacy.",
  "type": "object",
  "required": [
    "exportContract",
    "artifactIdentity",
    "manifest",
    "profile",
    "diagnosticReport",
    "diagnosis",
    "script",
    "remediationExecution",
    "calibrationEvidence"
  ],
  "not": {
    "required": [
      "experiment"
    ]
  },
  "properties": {
    "exportContract": {
      "type": "object",
      "required": [
        "name",
        "version",
        "generatedAt",
        "canonicalBlocks",
        "optionalBlocks",
        "deprecatedBlocks",
        "compatibility"
      ],
      "properties": {
        "name": {
          "const": "aura-technical-export"
        },
        "version": {
          "const": "2.1"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "canonicalBlocks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "const": "artifactIdentity"
            },
            {
              "const": "manifest"
            },
            {
              "const": "profile"
            },
            {
              "const": "diagnosis"
            },
            {
              "const": "script"
            },
            {
              "const": "remediationExecution"
            },
            {
              "const": "calibrationEvidence"
            }
          ],
          "items": false,
          "contains": {
            "const": "calibrationEvidence"
          }
        },
        "optionalBlocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "deprecatedBlocks": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "contains": {
            "type": "object",
            "required": [
              "from",
              "to",
              "removedIn",
              "reason"
            ],
            "properties": {
              "from": {
                "const": "experiment"
              },
              "to": {
                "const": "calibrationEvidence"
              },
              "removedIn": {
                "const": "2.0"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "required": [
            "legacyAliasIncluded",
            "migration"
          ],
          "properties": {
            "legacyAliasIncluded": {
              "const": false
            },
            "migration": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifactIdentity": {
      "type": "object",
      "required": [
        "runId",
        "reportId",
        "datasetSha256",
        "diagnosisReceiptHash",
        "reportContentHash"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "reportId": { "type": "string", "minLength": 1 },
        "datasetSha256": { "type": ["string", "null"] },
        "diagnosisReceiptHash": { "type": ["string", "null"] },
        "reportContentHash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "generatedAt",
        "dataset",
        "app",
        "objectivesCoverage",
        "artifacts",
        "allowedClaims",
        "calibrationSummary",
        "validationSummary",
        "limitations"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "dataset": {
          "type": "object"
        },
        "app": {
          "type": "object"
        },
        "objectivesCoverage": {
          "type": "array"
        },
        "artifacts": {
          "type": "array"
        },
        "allowedClaims": {
          "type": "object"
        },
        "calibrationSummary": {
          "$ref": "#/$defs/calibrationSummary"
        },
        "validationSummary": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": [
        "report",
        "auditEvidence"
      ],
      "properties": {
        "report": {
          "type": "object"
        },
        "auditEvidence": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "diagnosticReport": {
      "type": ["object", "null"]
    },
    "diagnosis": {
      "type": "object",
      "required": [
        "status",
        "model",
        "providerType",
        "diagnosisText",
        "structuredDiagnosis",
        "failureEvidence",
        "inputSnapshot",
        "executionReceipt",
        "rawResponseHash",
        "rawResponse"
      ],
      "properties": {
        "status": {
          "enum": ["valid", "invalid", "not_run"]
        },
        "model": {
          "type": "string"
        },
        "providerType": {
          "enum": [
            "cloud",
            "chrome",
            "ollama",
            "webllm_experimental",
            "local"
          ]
        },
        "diagnosisText": {
          "type": "string"
        },
        "structuredDiagnosis": {
          "type": ["object", "null"]
        },
        "failureEvidence": {
          "type": ["object", "null"]
        },
        "inputSnapshot": {
          "type": ["object", "null"]
        },
        "executionReceipt": {
          "type": ["object", "null"]
        },
        "rawResponseHash": {
          "type": ["string", "null"]
        },
        "rawResponse": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "required": [
        "generatedScript",
        "scriptValidation",
        "approvedScript",
        "remediationPlan",
        "contract",
        "verification",
        "approvalStatus"
      ],
      "properties": {
        "generatedScript": {
          "type": "string"
        },
        "scriptValidation": {
          "type": [
            "object",
            "null"
          ]
        },
        "approvedScript": {
          "type": "string"
        },
        "remediationPlan": {
          "type": ["object", "null"]
        },
        "contract": {
          "type": ["object", "null"]
        },
        "verification": {
          "type": ["object", "null"]
        },
        "approvalStatus": {
          "enum": ["not_requested", "pending", "approved", "unverified"]
        }
      },
      "additionalProperties": false
    },
    "remediationExecution": {
      "type": "object",
      "required": [
        "status",
        "executionBundle",
        "pythonReceipt",
        "verification",
        "correctedDataset",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": ["not_run", "prepared", "invalid", "verified", "reaudited"]
        },
        "executionBundle": { "type": ["object", "null"] },
        "pythonReceipt": { "type": ["object", "null"] },
        "verification": {
          "anyOf": [
            { "$ref": "#/$defs/remediationVerification" },
            { "type": "null" }
          ]
        },
        "correctedDataset": {
          "anyOf": [
            { "$ref": "#/$defs/correctedDataset" },
            { "type": "null" }
          ]
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "not_run" },
            "executionBundle": { "type": "null" },
            "pythonReceipt": { "type": "null" },
            "verification": { "type": "null" },
            "correctedDataset": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "prepared" },
            "executionBundle": { "type": "object" },
            "pythonReceipt": { "type": "null" },
            "verification": { "type": "null" },
            "correctedDataset": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "invalid" },
            "executionBundle": { "type": ["object", "null"] },
            "pythonReceipt": { "type": ["object", "null"] },
            "verification": { "type": "null" },
            "correctedDataset": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "verified" },
            "executionBundle": { "type": "object" },
            "pythonReceipt": { "type": "object" },
            "verification": { "type": "null" },
            "correctedDataset": { "$ref": "#/$defs/correctedDataset" }
          }
        },
        {
          "properties": {
            "status": { "const": "reaudited" },
            "executionBundle": { "type": "object" },
            "pythonReceipt": { "type": "object" },
            "verification": { "$ref": "#/$defs/remediationVerification" },
            "correctedDataset": { "$ref": "#/$defs/correctedDataset" }
          }
        }
      ],
      "additionalProperties": false
    },
    "calibrationEvidence": {
      "type": "object",
      "required": [
        "classification",
        "summary",
        "results",
        "improvementRun"
      ],
      "properties": {
        "classification": {
          "const": "experimental"
        },
        "summary": {
          "$ref": "#/$defs/calibrationSummary"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "improvementRun": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "deterministicValidation": {
      "type": "object"
    },
    "hitlDecision": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "correctedDataset": {
      "type": "object",
      "required": ["sha256", "rowCount", "columnCount", "includedInEvidenceArchive"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rowCount": { "type": "integer", "minimum": 0 },
        "columnCount": { "type": "integer", "minimum": 0 },
        "includedInEvidenceArchive": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "remediationVerificationSummary": {
      "type": "object",
      "required": ["score", "issueCount", "rowCount", "columnCount"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "issueCount": { "type": "integer", "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "columnCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "remediationVerification": {
      "type": "object",
      "required": [
        "contractId", "contractVersion", "executionId", "executedAt",
        "before", "after", "findings", "outcome", "limitations"
      ],
      "properties": {
        "contractId": { "const": "aura.remediation-verification.v1" },
        "contractVersion": { "const": "1.0.0" },
        "executionId": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/remediationVerificationSummary" },
        "after": { "$ref": "#/$defs/remediationVerificationSummary" },
        "findings": {
          "type": "object",
          "required": ["resolved", "persistent", "new"],
          "properties": {
            "resolved": { "type": "array" },
            "persistent": { "type": "array" },
            "new": { "type": "array" }
          },
          "additionalProperties": false
        },
        "outcome": { "enum": ["improved", "unchanged", "worsened", "inconclusive"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "calibrationSummary": {
      "type": "object",
      "required": [
        "totalRuns",
        "completedRuns",
        "failedOrUnavailableRuns",
        "formalRuns",
        "status",
        "statement",
        "limitations"
      ],
      "properties": {
        "totalRuns": {
          "type": "integer",
          "minimum": 0
        },
        "completedRuns": {
          "type": "integer",
          "minimum": 0
        },
        "failedOrUnavailableRuns": {
          "type": "integer",
          "minimum": 0
        },
        "formalRuns": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "none",
            "attempted",
            "preliminary",
            "formal"
          ]
        },
        "statement": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
