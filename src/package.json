{
  "name": "datahealth-ai-auditor",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync:formal-oracle": "node scripts/sync-formal-oracle.mjs",
    "ollama:validate": "node scripts/validate-ollama.mjs",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evidence:deterministic": "npx tsx ../experiments/benchmarks/generate_final_deterministic_evidence.ts",
    "contracts:baseline": "npx tsx ../experiments/contracts-v2/baseline/run-baseline.mjs",
    "contracts:evaluate": "npx tsx ../experiments/contracts-v2/baseline/evaluate.mjs",
    "contracts:compare": "npx tsx ../experiments/contracts-v2/compare-baseline.mjs",
    "contracts:v2:validate-local": "npx tsx ../experiments/contracts-v2/run-local-dataset-validation.mjs",
    "oe4:python:run": "node ../experiments/final-evaluation/run-python-representative.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@mlc-ai/web-llm": "^0.2.83",
    "d3": "^7.9.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.555.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  }
}
